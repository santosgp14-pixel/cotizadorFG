rules_version = '2';

// Reglas de Firestore para el Control de Siniestros.
// Solo los UID listados en esAdmin() pueden leer/escribir
// (Firebase Console → Authentication → Users → columna "User UID").
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null && request.auth.uid in [
        'A3hyN3uMqagW9Vnel64F8kfU8q32',
        'HYg4Q8B4v9Y8w3UGNqJgfGs7n4l1'
      ];
    }

    function esValido() {
      let d = request.resource.data;
      return d.cedula is string && d.cedula.size() > 0 && d.cedula.size() <= 20
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
        && d.parentesco in ['Titular', 'Cónyuge', 'Hijo(a)', 'Padre', 'Madre', 'Otro']
        && d.fechaNacimiento is string && d.fechaNacimiento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.fechaOcurrencia is string && d.fechaOcurrencia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.causa is string && d.causa.size() > 0 && d.causa.size() <= 200
        && d.estatus in ['Pendiente', 'En revisión', 'Pagado', 'Pagado parcial', 'Rechazado']
        && d.montoPagado is number && d.montoPagado >= 0
        && d.montoRechazado is number && d.montoRechazado >= 0;
    }

    match /siniestros/{id} {
      allow read, delete: if esAdmin();
      allow create, update: if esAdmin() && esValido();
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
